# 复制为 .env 并修改下列值
# Flask 主服务端口
APP_PORT=8080
# 金价监控独立服务端口(用于 /health 健康检查)
MONITOR_PORT=9000

# 管理员账号(首次启动时若管理员表为空则用此值初始化)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# JWT 密钥(请用随机长字符串,泄漏会导致任何人可签发 token)
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=7

# SQLite 路径(相对 backend/ 或绝对路径)
DB_PATH=data.db

# 上传目录(图片存放)
UPLOAD_DIR=uploads
# 单文件最大字节数(默认 5MB)
MAX_UPLOAD_BYTES=5242880

# 金价品类(京东金融产品代码)
GOLD_PRODUCT_CODE=Au99.99
# 默认拉取周期(秒),启动后可在前端修改并写入数据库
GOLD_POLL_INTERVAL=300
# 京东金融 API
JD_GOLD_API=https://ms.jr.jd.com/gw/generic/hj/h5/m/latestPrice
