[Unit]
Description=Personal Site Gold Price Monitor (9000)
After=network.target personal-site.service
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/opt/personal-site/backend
EnvironmentFile=/opt/personal-site/backend/.env
ExecStart=/opt/personal-site/backend/.venv/bin/python monitor.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/personal-site/monitor.log
StandardError=append:/var/log/personal-site/monitor-error.log

[Install]
WantedBy=multi-user.target
